# Derived / input data: reproducible, not source.
.orch/
__pycache__/
**/__pycache__/

# The linked test program is a build product of tools/link_test.py.
re/build/ts_link_test

# The boot driver and its object cache are build products of tools/boot.py.
# The cache is what makes a boot after a one-file edit take seconds instead of
# ninety, so it is kept on disk and never committed.
re/build/boot_driver
re/build/boot_obj/

# The layout-check translation unit and its report program are build products
# of tools/gen_layout_check.py, regenerated on every run.
re/build/layout_check.cpp
re/build/layout_report

# Raw CD images and the extracted ISO trees. These are ~2.7 GB and are inputs
# to the recovery pipeline, not part of the reconstruction. Keeping them out of
# git is what makes `git push` finish.
ts1.bin
ts2.bin
ts1.cue
ts2.cue
work/

# re/out/ is fully regenerated by the pipeline (stage 2 onward), so it is an
# artifact, not source. functions.json alone is 64 MB, over GitHub's 50 MB
# warning threshold, and it was 92% of everything tracked under re/out. The
# small recovered JSON files stay tracked for convenience; the one big
# intermediate does not. A fresh clone runs ./tools/pipeline.sh and has it back
# in about two minutes.
re/out/functions.json

# Ghidra project: 544 MB of analysis cache, regenerated by tools/ghidra.sh.
ghidra-proj/

# Wine prefix and staged retail game files: 600 MB of derived data.
.wine/
.wine32/
gamedir/

# Agent worktrees (Claude Code), local-only.
.claude/worktrees/
